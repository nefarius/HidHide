{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "definitions": {
    "Host": {
      "type": "string",
      "enum": [
        "AppVeyor",
        "AzurePipelines",
        "Bamboo",
        "Bitbucket",
        "Bitrise",
        "GitHubActions",
        "GitLab",
        "Jenkins",
        "Rider",
        "SpaceAutomation",
        "TeamCity",
        "Terminal",
        "TravisCI",
        "VisualStudio",
        "VSCode"
      ]
    },
    "ExecutableTarget": {
      "type": "string",
      "enum": [
        "Ci",
        "Clean",
        "Compile",
        "PackageCab",
        "PackageMsi",
        "Release",
        "ResolveVersion",
        "Restore",
        "StageInstallerPayload",
        "Test",
        "TestSignStagingDriver",
        "TestVersion"
      ]
    },
    "Verbosity": {
      "type": "string",
      "description": "",
      "enum": [
        "Verbose",
        "Normal",
        "Minimal",
        "Quiet",
        "Information"
      ]
    },
    "FalloutBuild": {
      "properties": {
        "Continue": {
          "type": "boolean",
          "description": "Indicates to continue a previously failed build attempt"
        },
        "Help": {
          "type": "boolean",
          "description": "Shows the help text for this build assembly"
        },
        "Host": {
          "description": "Host for execution. Default is 'automatic'",
          "$ref": "#/definitions/Host"
        },
        "NoLogo": {
          "type": "boolean",
          "description": "Disables displaying the Fallout logo"
        },
        "Partition": {
          "type": "string",
          "description": "Partition to use on CI"
        },
        "Plan": {
          "type": "boolean",
          "description": "Shows the execution plan (HTML)"
        },
        "Profile": {
          "type": "array",
          "description": "Defines the profiles to load",
          "items": {
            "type": "string"
          }
        },
        "Root": {
          "type": "string",
          "description": "Root directory during build execution"
        },
        "Skip": {
          "type": "array",
          "description": "List of targets to be skipped. Empty list skips all dependencies",
          "items": {
            "$ref": "#/definitions/ExecutableTarget"
          }
        },
        "Target": {
          "type": "array",
          "description": "List of targets to be invoked. Default is '{default_target}'",
          "items": {
            "$ref": "#/definitions/ExecutableTarget"
          }
        },
        "Verbosity": {
          "description": "Logging verbosity during build execution. Default is 'Normal'",
          "$ref": "#/definitions/Verbosity"
        },
        "BuildProjectFile": {
          "type": [
            "null",
            "string"
          ],
          "description": "Path to the build project (.csproj) relative to the repository root. Defaults to 'build/_build.csproj' when unset. Read by the Fallout global tool's in-tool runner."
        }
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "CertificateSubject": {
          "type": "string",
          "description": "Certificate subject used for local production signing"
        },
        "Configuration": {
          "type": "string",
          "description": "Configuration to build - Default is 'Debug' (local) or 'Release' (server)"
        },
        "GitHubOutput": {
          "type": "string",
          "description": "GITHUB_OUTPUT file that receives ResolveVersion results"
        },
        "GitHubToken": {
          "type": "string",
          "description": "GitHub token used to download Actions artifacts. Defaults to GH_TOKEN or GITHUB_TOKEN",
          "default": "Secrets must be entered via 'fallout :secrets [profile]'"
        },
        "HidHideTestSignPfx": {
          "type": "string",
          "description": "Optional PFX used to test-sign the staged driver. CI generates an ephemeral certificate when omitted"
        },
        "HidHideTestSignPfxPassword": {
          "type": "string",
          "description": "Password for HidHideTestSignPfx",
          "default": "Secrets must be entered via 'fallout :secrets [profile]'"
        },
        "NoSigning": {
          "type": "boolean",
          "description": "Download release artifacts without signing them"
        },
        "Platform": {
          "type": "string",
          "description": "Platform to build: x64 | ARM64"
        },
        "ReleaseOutput": {
          "type": "string",
          "description": "Directory that receives downloaded release artifacts"
        },
        "ReleaseRef": {
          "type": "string",
          "description": "Git ref resolved by ResolveVersion, for example refs/tags/v1.8.0"
        },
        "ReleaseTag": {
          "type": "string",
          "description": "Release tag whose successful GitHub Actions artifacts are downloaded, for example v1.8.0"
        },
        "RunNumber": {
          "type": "integer",
          "format": "int32",
          "description": "GitHub Actions run number used as the fourth binary-version component"
        }
      }
    },
    {
      "$ref": "#/definitions/FalloutBuild"
    }
  ]
}
