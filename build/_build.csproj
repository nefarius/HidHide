<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0618;CS8618;NU1901;NU1903</NoWarn>
    <RootNamespace>HidHide.Build</RootNamespace>
    <FalloutRootDirectory>..</FalloutRootDirectory>
    <FalloutScriptDirectory>..</FalloutScriptDirectory>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fallout.Common" Version="10.5.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageDownload Include="Nefarius.Tools.WDKWhere" Version="[1.5.0]" />
  </ItemGroup>
</Project>

